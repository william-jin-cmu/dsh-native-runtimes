{
  "name": "dsh-native-runtimes",
  "version": "0.1.0",
  "description": "Native Third-party Runtimes: let a DeepSeek Harness agent hand work to the Claude Code, Codex and ACP agents already installed on this machine, as threads it can follow up on.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "claude-code",
    "codex",
    "acp",
    "agents",
    "threads"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/william-jin-cmu/dsh-native-runtimes.git"
  },
  "homepage": "https://github.com/william-jin-cmu/dsh-native-runtimes#readme",
  "bugs": {
    "url": "https://github.com/william-jin-cmu/dsh-native-runtimes/issues"
  },
  "author": "William Jin",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "pack": "node scripts/build.mjs && pnpm pack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.7.0"
}
